# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Supabase Configuration (Optional - for auth alternative)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_DB_SCHEMA_CACHE_ENABLED=false

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your-s3-bucket-name

# Square Payment Configuration
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_square_location_id
SUPPORT_EMAIL=support@yourdomain.com
FRONTEND_URL=http://localhost:8080
FRONTEND_CHECKOUT_URL=http://localhost:5173

# Square Webhooks
SQUARE_WEBHOOK_URL=https://your-api-domain.com/api/v1/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your App Name
ADMIN_EMAIL=admin@yourdomain.com

# Event Configuration
EVENT_TIMEZONE=America/New_York
EVENT_DURATION_HOURS=1

# Company Information
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=info@yourdomain.com
COMPANY_PHONE=+1 123 456 7890

# CORS Origins (for production)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173
